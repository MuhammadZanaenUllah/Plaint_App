{
  "expo": {
    "name": "Planit",
    "slug": "plaint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon-default.png",
    "scheme": "planit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/ios-icon-default.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-monochrome.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "pk.planit",
      "appleTeamId": "Y9Q8B6NUBB",
      "googleServicesFile": "./assets/files/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "This app uses the microphone to record and send voice notes in chat.",
        "NSCameraUsageDescription": "Planit uses your camera to take photos and videos and send them in chat. For example, you can photograph a whiteboard or a document and share it with your team in a conversation.",
        "NSPhotoLibraryUsageDescription": "Planit uses your photo library so you can choose photos and videos to share in chat or set as your profile picture. For example, you can attach a screenshot of an issue to a task conversation.",
        "NSFaceIDUsageDescription": "Planit uses Face ID to let you sign in quickly and securely without typing your password."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pk.planit",
      "googleServicesFile": "./assets/files/google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/e77b3336-c148-415e-b0d0-479d536ea892",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-updates",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-notification-icon.png",
          "color": "#00DEAB",
          "sounds": [
            "./assets/sounds/notification.mp3",
            "./assets/sounds/chat_message.wav"
          ]
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Planit uses your photo library so you can choose photos and videos to share in chat or set as your profile picture. For example, you can attach a screenshot of an issue to a task conversation.",
          "savePhotosPermission": "Planit saves photos and videos you download from chat to your photo library. For example, you can save an image a teammate sent you.",
          "granularPermissions": []
        }
      ],
      "./plugins/withNotificationServiceExtension"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e77b3336-c148-415e-b0d0-479d536ea892",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "PlanitNotificationService",
                  "bundleIdentifier": "pk.planit.PlanitNotificationService"
                }
              ]
            }
          }
        }
      }
    }
  }
}
