+
+/**
+ * Planit chat notification aggregation.
+ *
+ * All chat notifications live in one Android notification group. There is one
+ * child notification per unique sender, and every unread message from that
+ * sender is kept so the child can show an InboxStyle history.
+ *
+ * Android limitation: a notification group is flat. The collapsed group shows
+ * the Planit summary; expanding it shows the sender children. The sender rows
+ * cannot be injected into the collapsed group itself without a custom
+ * RemoteViews layout, which is not reliable across Android versions/OEMs.
+ */
+object PlanitChatNotification {
+  const val GROUP_KEY = "pk.planit.CHAT_NOTIFICATIONS"
+  const val SUMMARY_TAG = "pk.planit.CHAT_NOTIFICATIONS_SUMMARY"
+  const val SUMMARY_ID = 0x504C414E
+  const val DISMISS_EXTRA_TAG = "pk.planit.chat.DISMISS_TAG"
+
+  private const val CHILD_ID = 0
+  private const val SENDER_TAG_PREFIX = "pk.planit.chat.sender."
+
+  private const val PREFS_NAME = "planit_chat_notification_senders"
+  private const val PREFS_MESSAGES = "messages_v2"
+  private const val PREFS_SEEN = "seen_ids"
+  private const val MAX_STORED_MESSAGES = 500
+  private const val MAX_CHILD_LINES = 4
+  private const val MAX_SENDERS = 12
+  private const val MAX_SEEN = 500
+  private const val MAX_LINES = 8
+  private const val MAX_PREVIEW = 512
+
+  private const val FALLBACK_CHANNEL_ID =
+    "expo_notifications_fallback_notification_channel"
+
+  private val objectIdPattern = Regex("^[a-fA-F0-9]{24}$")
+  private val nameColonPattern = Regex("^([^:\\n]{1,80}):\\s*([\\s\\S]*)$")
+  private val sentPattern = Regex(
+    "^(.{1,80}?)\\s+(?:has\\s+)?sent\\s+(?:you\\s+)?(?:a\\s+)?(?:message|file|photo|image|video|voice\\s+note|attachment|document)\\b.*$",
+    RegexOption.IGNORE_CASE
+  )
+  private val newMessageFromPattern = Regex(
+    "^new message from\\s+(.{1,80})$",
+    RegexOption.IGNORE_CASE
+  )
+  private val genericSenders = setOf(
+    "planit",
+    "planit chat",
+    "chat",
+    "message",
+    "message from planit",
+    "new message",
+    "new messages",
+    "notification",
+    "sent a message",
+    "sent you a message"
+  )
+
+  data class ParsedChat(
+    val senderId: String?,
+    val senderName: String?,
+    val preview: String,
+    val roomId: String?,
+    val messageId: String?,
+    val timestamp: Long?
+  )
+
+  private data class StoredMessage(
+    val id: String,
+    val senderKey: String,
+    val senderId: String?,
+    val senderName: String,
+    val preview: String,
+    val roomId: String?,
+    val time: Long,
+    val receivedAt: Long,
+    val channelId: String?
+  )
+
+  private data class SenderAggregate(
+    val key: String,
+    val senderId: String?,
+    val senderName: String,
+    val count: Int,
+    val preview: String,
+    val roomId: String?,
+    val lastTime: Long,
+    val channelId: String?,
+    val messages: List<StoredMessage>
+  ) {
+    val tag: String get() = tagFor(key)
+  }
+
+  fun isChat(content: INotificationContent): Boolean {
+    return content.body?.optString("type")?.equals("chat", ignoreCase = true) == true
+  }
+
+  fun parse(content: INotificationContent): ParsedChat {
+    val data = content.body
+    val text = content.text?.trim().orEmpty()
+    val title = content.title?.trim().orEmpty()
+
+    val senderId = firstNonBlank(
+      data?.optString("sender_id"),
+      data?.optString("senderId"),
+      data?.optString("user_id"),
+      data?.optString("userId"),
+      data?.optString("from_id"),
+      data?.optString("fromId")
+    )
+    var senderName = cleanName(
+      firstNonBlank(
+        data?.optString("sender_name"),
+        data?.optString("senderName"),
+        data?.optString("user_name"),
+        data?.optString("userName"),
+        data?.optString("from_name"),
+        data?.optString("fromName")
+      )
+    )
+    val explicitPreview = firstNonBlank(
+      data?.optString("message"),
+      data?.optString("text"),
+      data?.optString("message_text"),
+      data?.optString("preview"),
+      data?.optString("content")
+    )
+    val messageId = firstNonBlank(
+      data?.optString("message_id"),
+      data?.optString("messageId"),
+      data?.optString("_id"),
+      data?.optString("id")
+    )
+    val roomId = firstNonBlank(
+      data?.optString("room_id"),
+      data?.optString("roomId")
+    )
+    val timestamp = parseTimestamp(
+      firstNonBlank(
+        data?.optString("created_at"),
+        data?.optString("createdAt"),
+        data?.optString("timestamp")
+      )
+    )
+
+    var preview: String? = explicitPreview
+    if (senderName == null) {
+      val extracted = extractFromText(text, title)
+      senderName = extracted.first
+      if (preview == null) preview = extracted.second
+    }
+    if (preview == null) {
+      preview = previewFromText(text, senderName)
+    }
+
+    return ParsedChat(
+      senderId = senderId?.takeIf { it.isNotBlank() },
+      senderName = cleanName(senderName),
+      preview = normalizePreview(
+        preview ?: "Sent you a message",
+        cleanName(senderName)
+      )
+        .take(MAX_PREVIEW)
+        .takeIf { it.isNotBlank() }
+        ?: "Sent you a message",
+      roomId = roomId?.takeIf { it.isNotBlank() },
+      messageId = messageId?.takeIf { it.isNotBlank() },
+      timestamp = timestamp
+    )
+  }
+
+  @Synchronized
+  fun onNotificationPosted(
+    context: Context,
+    notification: Notification,
+    notificationManager: NotificationManagerCompat
+  ) {
+    val content = notification.notificationRequest.content
+    if (!isChat(content)) {
+      return
+    }
+
+    val parsed = parse(content)
+    val systemNotificationManager =
+      context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    val currentMessageId = parsed.messageId
+      ?: notification.notificationRequest.identifier.takeIf { it.isNotBlank() }
+
+    // A repeated delivery of the same message must not increase any counter.
+    val seen = loadSeen(context)
+    if (currentMessageId != null && seen.contains(currentMessageId)) {
+      Log.d("PlanitChatNotification", "Ignoring duplicate chat push: $currentMessageId")
+      return
+    }
+
+    val senderKey = when {
+      !parsed.senderId.isNullOrBlank() -> "id:${parsed.senderId}"
+      !parsed.senderName.isNullOrBlank() -> "name:${normalizeName(parsed.senderName)}"
+      else -> "message:${currentMessageId ?: UUID.randomUUID()}"
+    }
+
+    val active = activeNotifications(systemNotificationManager)
+
+    // Remove legacy per-message chat children from older app versions.
+    active.forEach { statusBarNotification ->
+      val tag = statusBarNotification.tag ?: return@forEach
+      if (
+        tag != SUMMARY_TAG &&
+        !tag.startsWith(SENDER_TAG_PREFIX) &&
+        statusBarNotification.notification.group == GROUP_KEY
+      ) {
+        runCatching { systemNotificationManager.cancel(tag, statusBarNotification.id) }
+      }
+    }
+
+    // Never drop stored messages here. A row may be temporarily absent while a
+    // read is failing; removing its messages would lose unread state. Explicit
+    // dismissal and a successful markRoomRead are the only paths that clear
+    // messages.
+    val messages = loadMessages(context).toMutableList()
+
+    val channelId = resolveChannelId(context, notification)
+    val receivedAt = System.currentTimeMillis()
+    val stored = StoredMessage(
+      id = currentMessageId ?: UUID.randomUUID().toString(),
+      senderKey = senderKey,
+      senderId = parsed.senderId,
+      senderName = parsed.senderName ?: "New message",
+      preview = parsed.preview,
+      roomId = parsed.roomId,
+      time = parsed.timestamp ?: receivedAt,
+      receivedAt = receivedAt,
+      channelId = channelId
+    )
+
+    messages.removeAll { it.id == stored.id }
+    messages.add(stored)
+
+    val trimmed = if (messages.size > MAX_STORED_MESSAGES) {
+      messages.sortedBy { it.receivedAt }.takeLast(MAX_STORED_MESSAGES).toMutableList()
+    } else {
+      messages
+    }
+
+    saveMessages(context, trimmed)
+    if (currentMessageId != null) {
+      saveSeen(context, (seen + currentMessageId).takeLast(MAX_SEEN))
+    }
+
+    val aggregates = aggregate(trimmed)
+    val wantedTags = aggregates.map { it.tag }.toSet()
+    active.forEach { statusBarNotification ->
+      val tag = statusBarNotification.tag ?: return@forEach
+      if (tag.startsWith(SENDER_TAG_PREFIX) && tag !in wantedTags) {
+        runCatching { systemNotificationManager.cancel(tag, statusBarNotification.id) }
+      }
+    }
+
+    // Update every sender row, but only the sender that just received a
+    // message is allowed to alert.
+    aggregates.forEach { sender ->
+      postSenderChild(
+        context,
+        notificationManager,
+        sender,
+        alert = sender.key == senderKey
+      )
+    }
+    postSummary(context, notificationManager, aggregates)
+  }
+
+  /**
+   * Called after the backend successfully marks a room as read. Removes only
+   * messages belonging to that room and recalculates every sender from the
+   * remaining messages (including messages from the same sender in other
+   * rooms).
+   *
+   * [beforeTime] is the device time captured before the read request. Messages
+   * received after that time are left unread so a message that raced the read
+   * request is not lost.
+   */
+  @Synchronized
+  fun markRoomRead(context: Context, roomId: String?, beforeTime: Long?) {
+    if (roomId.isNullOrBlank()) {
+      return
+    }
+    val all = loadMessages(context)
+    val remaining = all.filterNot { message ->
+      message.roomId == roomId &&
+        (beforeTime == null || message.receivedAt <= beforeTime)
+    }
+    if (remaining.size == all.size) {
+      return
+    }
+    saveMessages(context, remaining)
+    val systemNotificationManager =
+      context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    rebuildNotifications(
+      context,
+      systemNotificationManager,
+      aggregate(remaining),
+      alert = false
+    )
+  }
+
+  @Synchronized
+  fun onSenderDismissed(context: Context, tag: String?) {
+    if (tag.isNullOrBlank()) {
+      return
+    }
+    val systemNotificationManager =
+      context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    val active = activeNotifications(systemNotificationManager)
+    val activeTags = active
+      .filter { statusBarNotification ->
+        val currentTag = statusBarNotification.tag
+        currentTag != null &&
+          currentTag != SUMMARY_TAG &&
+          statusBarNotification.id != SUMMARY_ID &&
+          currentTag.startsWith(SENDER_TAG_PREFIX) &&
+          currentTag != tag
+      }
+      .mapNotNull { it.tag }
+      .toSet()
+
+    val remaining = loadMessages(context)
+      .filterNot { tagFor(it.senderKey) == tag }
+    saveMessages(context, remaining)
+    // Only summarize rows that are still visible. Keep any stored messages for
+    // other senders so a failed read does not delete their unread state.
+    val activeAggregates = aggregate(
+      remaining.filter { tagFor(it.senderKey) in activeTags }
+    )
+    if (activeAggregates.isEmpty()) {
+      cancelSummary(systemNotificationManager)
+    } else {
+      postSummary(
+        context,
+        NotificationManagerCompat.from(context),
+        activeAggregates
+      )
+    }
+  }
+
+  private fun rebuildNotifications(
+    context: Context,
+    systemNotificationManager: NotificationManager,
+    aggregates: List<SenderAggregate>,
+    alert: Boolean
+  ) {
+    val notificationManager = NotificationManagerCompat.from(context)
+    val active = activeNotifications(systemNotificationManager)
+    val wantedTags = aggregates.map { it.tag }.toSet()
+    active.forEach { statusBarNotification ->
+      val tag = statusBarNotification.tag ?: return@forEach
+      if (tag.startsWith(SENDER_TAG_PREFIX) && tag !in wantedTags) {
+        runCatching { systemNotificationManager.cancel(tag, statusBarNotification.id) }
+      }
+    }
+    aggregates.forEach { sender ->
+      postSenderChild(context, notificationManager, sender, alert)
+    }
+    if (aggregates.isEmpty()) {
+      cancelSummary(systemNotificationManager)
+    } else {
+      postSummary(context, notificationManager, aggregates)
+    }
+  }
+
+  private fun aggregate(messages: List<StoredMessage>): List<SenderAggregate> {
+    return messages.groupBy { it.senderKey }.map { (key, list) ->
+      val sorted = list.sortedBy { it.time }
+      val latest = sorted.last()
+      SenderAggregate(
+        key = key,
+        senderId = latest.senderId,
+        senderName = latest.senderName,
+        count = sorted.size,
+        preview = latest.preview,
+        roomId = latest.roomId,
+        lastTime = latest.time,
+        channelId = sorted.lastOrNull { it.channelId != null }?.channelId,
+        messages = sorted
+      )
+    }.sortedBy { it.lastTime }
+  }
+
+  private fun extractFromText(text: String, title: String): Pair<String?, String?> {
+    if (text.isNotBlank()) {
+      nameColonPattern.find(text)?.let { match ->
+        val name = cleanName(match.groupValues[1])
+        if (name != null) {
+          return name to match.groupValues[2].trim().ifBlank { "Sent you a message" }
+        }
+      }
+      sentPattern.find(text)?.let { match ->
+        val name = cleanName(match.groupValues[1])
+        if (name != null) {
+          return name to "Sent you a message"
+        }
+      }
+      newMessageFromPattern.find(text)?.let { match ->
+        val name = cleanName(match.groupValues[1])
+        if (name != null) {
+          return name to "Sent you a message"
+        }
+      }
+    }
+    val titleName = cleanName(title)
+    if (titleName != null) {
+      return titleName to text.takeIf { it.isNotBlank() }
+    }
+    return null to null
+  }
+
+  private fun previewFromText(text: String, name: String?): String? {
+    if (text.isBlank() || objectIdPattern.matches(text)) {
+      return null
+    }
+    if (sentPattern.find(text) != null) {
+      return "Sent you a message"
+    }
+    if (!name.isNullOrBlank() && text.startsWith("$name:", ignoreCase = true)) {
+      return text.substring(name.length + 1).trim().takeIf { it.isNotBlank() }
+    }
+    return text
+  }
+
+  /**
+   * Group and channel pushes use "Sender name: preview" in the body. The data
+   * payload usually has the clean preview, but older/fallback payloads can
+   * still include the sender prefix. Strip only an exact leading sender name so
+   * the notification never repeats the sender inside the message line.
+   */
+  private fun normalizePreview(raw: String, senderName: String?): String {
+    var preview = raw.trim()
+    if (preview.isEmpty() || senderName.isNullOrBlank()) {
+      return preview
+    }
+    val quotedName = Regex.escape(senderName.trim())
+    val prefixes = listOf(
+      Regex("^$quotedName\\s*:\\s*", RegexOption.IGNORE_CASE),
+      Regex("^$quotedName\\s*-\\s*", RegexOption.IGNORE_CASE),
+      Regex("^$quotedName\\s+", RegexOption.IGNORE_CASE)
+    )
+    for (prefix in prefixes) {
+      val stripped = preview.replaceFirst(prefix, "").trim()
+      if (stripped.isNotEmpty() && stripped != preview) {
+        preview = stripped
+        break
+      }
+    }
+    return preview
+  }
+
+  private fun postSenderChild(
+    context: Context,
+    notificationManager: NotificationManagerCompat,
+    sender: SenderAggregate,
+    alert: Boolean
+  ) {
+    val channelId = sender.channelId ?: fallbackChannelId(context)
+    val builder = if (channelId != null) {
+      NotificationCompat.Builder(context, channelId)
+    } else {
+      NotificationCompat.Builder(context)
+    }
+
+    builder.setSmallIcon(resolveSmallIcon(context))
+    resolveColor(context)?.let { builder.color = it }
+    resolveLargeIcon(context)?.let { builder.setLargeIcon(it) }
+    builder.setContentTitle("${sender.senderName} (${sender.count})")
+    builder.setContentText(sender.preview)
+    builder.setNumber(sender.count)
+
+    // MessagingStyle is intentionally not used here. On Android 12+/OEM
+    // SystemUI the child title becomes "conversationTitle: senderName", which
+    // repeats the sender, and the child's subText/number are not drawn in the
+    // grouped row. InboxStyle gives us a stable sender/count title and a
+    // readable list of the accumulated unread messages.
+    val shown = sender.messages.takeLast(MAX_CHILD_LINES)
+    val hidden = sender.messages.size - shown.size
+    val inboxStyle = NotificationCompat.InboxStyle()
+      .setBigContentTitle(
+        "${sender.senderName} (${sender.count} ${messageWord(sender.count)})"
+      )
+    if (hidden > 0) {
+      inboxStyle.addLine("$hidden earlier ${messageWord(hidden)}")
+    }
+    shown.forEach { message -> inboxStyle.addLine(message.preview) }
+    builder.setStyle(inboxStyle)
+
+    builder.setWhen(sender.lastTime)
+    builder.setShowWhen(true)
+    builder.setPriority(NotificationCompat.PRIORITY_HIGH)
+    builder.setCategory(NotificationCompat.CATEGORY_MESSAGE)
+    // Do not auto-cancel on tap. The row is removed only after the backend
+    // read succeeds (markRoomRead), so a failed read cannot silently clear it.
+    builder.setAutoCancel(false)
+    builder.setOnlyAlertOnce(!alert)
+    builder.setGroup(GROUP_KEY)
+    builder.setGroupAlertBehavior(NotificationCompat.GROUP_ALERT_CHILDREN)
+    if (!alert) {
+      builder.setSilent(true)
+    } else if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+      builder.setDefaults(NotificationCompat.DEFAULT_ALL)
+    }
+    builder.setContentIntent(senderIntent(context, sender))
+    builder.setDeleteIntent(dismissIntent(context, sender))
+    notificationManager.notify(sender.tag, CHILD_ID, builder.build())
+  }
+
+  private fun postSummary(
+    context: Context,
+    notificationManager: NotificationManagerCompat,
+    senders: List<SenderAggregate>
+  ) {
+    if (senders.isEmpty()) {
+      val manager =
+        context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+      cancelSummary(manager)
+      return
+    }
+
+    val sorted = senders.sortedByDescending { it.lastTime }
+    val total = senders.sumOf { it.count }
+    val latest = sorted.first()
+    val channelId = summaryChannelId(context, senders)
+    val builder = if (channelId != null) {
+      NotificationCompat.Builder(context, channelId)
+    } else {
+      NotificationCompat.Builder(context)
+    }
+
+    builder.setSmallIcon(resolveSmallIcon(context))
+    resolveColor(context)?.let { builder.color = it }
+    resolveLargeIcon(context)?.let { builder.setLargeIcon(it) }
+    builder.setContentTitle("Planit")
+    builder.setContentText("${latest.senderName} (${latest.count}) - ${latest.preview}")
+    builder.setSubText("$total unread ${messageWord(total)}")
+    builder.setNumber(total)
+    builder.setWhen(latest.lastTime)
+    builder.setPriority(NotificationCompat.PRIORITY_HIGH)
+    builder.setCategory(NotificationCompat.CATEGORY_MESSAGE)
+    builder.setAutoCancel(true)
+    builder.setOnlyAlertOnce(true)
+    // Children alert; the summary must not alert a second time.
+    builder.setSilent(true)
+    builder.setGroup(GROUP_KEY)
+    builder.setGroupSummary(true)
+    builder.setGroupAlertBehavior(NotificationCompat.GROUP_ALERT_CHILDREN)
+
+    val shown = sorted.take(MAX_LINES)
+    val inboxStyle = NotificationCompat.InboxStyle()
+      .setBigContentTitle("Planit")
+    shown.forEach { inboxStyle.addLine(lineFor(it)) }
+    inboxStyle.setSummaryText("$total unread ${messageWord(total)}")
+    builder.setStyle(inboxStyle)
+
+    builder.setContentIntent(chatListIntent(context))
+    notificationManager.notify(SUMMARY_TAG, SUMMARY_ID, builder.build())
+  }
+
+  private fun lineFor(sender: SenderAggregate): String {
+    return "${sender.senderName} (${sender.count}) - ${sender.preview}"
+  }
+
+  private fun messageWord(count: Int): String = if (count == 1) "message" else "messages"
+
+  private fun senderWord(count: Int): String = if (count == 1) "sender" else "senders"
+
+  private fun tagFor(key: String): String = SENDER_TAG_PREFIX + key
+
+  private fun normalizeName(name: String): String {
+    return name.trim().replace(Regex("\\s+"), " ").lowercase()
+  }
+
+  private fun cleanName(raw: String?): String? {
+    val name = raw
+      ?.trim()
+      ?.replace(Regex("\\s+"), " ")
+      ?.takeIf { it.isNotEmpty() }
+      ?: return null
+    if (name.length > 80 || objectIdPattern.matches(name)) {
+      return null
+    }
+    if (name.lowercase() in genericSenders) {
+      return null
+    }
+    if (name.none { it.isLetter() }) {
+      return null
+    }
+    return name
+  }
+
+  private fun firstNonBlank(vararg values: String?): String? {
+    for (value in values) {
+      val trimmed = value?.trim()
+      if (
+        !trimmed.isNullOrBlank() &&
+        !trimmed.equals("null", ignoreCase = true)
+      ) {
+        return trimmed
+      }
+    }
+    return null
+  }
+
+  private fun parseTimestamp(raw: String?): Long? {
+    if (raw.isNullOrBlank()) {
+      return null
+    }
+    val patterns = listOf(
+      "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
+      "yyyy-MM-dd'T'HH:mm:ss'Z'",
+      "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
+      "yyyy-MM-dd'T'HH:mm:ssXXX"
+    )
+    for (pattern in patterns) {
+      try {
+        val format = SimpleDateFormat(pattern, Locale.US)
+        format.timeZone = TimeZone.getTimeZone("UTC")
+        val parsed = format.parse(raw)
+        if (parsed != null) {
+          return parsed.time
+        }
