+  override fun handleIntent(intent: Intent) {
+    try {
+      if (shouldConvertToDataMessage(intent)) {
+        val notificationKeys = intent.extras?.keySet()
+          ?.filter { it.startsWith("gcm.n.") || it.startsWith("gcm.notification.") }
+          .orEmpty()
+        if (notificationKeys.isNotEmpty()) {
+          val stripped = Intent(intent)
+          notificationKeys.forEach { stripped.removeExtra(it) }
+          super.handleIntent(stripped)
+          return
+        }
+      }
+    } catch (e: Exception) {
