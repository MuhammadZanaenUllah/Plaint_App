+package expo.modules.notifications.notifications.presentation
+
+import expo.modules.kotlin.exception.Exceptions
+import expo.modules.kotlin.modules.Module
+import expo.modules.kotlin.modules.ModuleDefinition
+
+/**
+ * JS bridge for the native Planit chat notification state.
+ *
+ * The app calls `markRoomRead` only after the backend read request succeeds, so
+ * the notification counts are not cleared prematurely on a failed read.
+ */
+class PlanitNotificationModule : Module() {
+  override fun definition() = ModuleDefinition {
+    Name("PlanitNotificationModule")
+
+    Function("markRoomRead") { roomId: String, beforeTime: Double? ->
+      val context = appContext.reactContext
+        ?: throw Exceptions.ReactContextLost()
+      PlanitChatNotification.markRoomRead(
+        context,
+        roomId,
+        beforeTime?.toLong()
+      )
+    }
+  }
+}
