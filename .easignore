# EAS Build archive exclusions.
# When this file exists, EAS uses it instead of .gitignore.

# Dependencies (installed by EAS during the build)
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Expo / Metro generated files
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Version control / local tooling / documentation not needed to build
.git/
.claude/
.vscode/
.freebuff/
Development/
ModulesMdFiles/
doc/
answers/
apis_documents/
prompts/
example
README.md
OTA_UPDATES_GUIDE.md
errors_paste.md
FIXEDISSUE.md
AGENT_API_INTEGRATION.md
api_integrationprompt.md
PLANIT_Backend_API_Documentation_VERBATIM_MASTER.md
output.txt
assets/implementationScreenshots/

# Native build outputs (regenerated by EAS)
.kotlin/
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/.cxx/
**/.cxx/
ios/
ios/build/
ios/Pods/
documents/

# Local env / signing secrets (already excluded by .gitignore)
.env
.env*.local
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*firebase-adminsdk*.json
android/local.properties

# Debug / scratch / generated artifacts
*.apk
*.aab
*.hprof
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*
.DS_Store
_scratch_screen.*
src/app/table-debug.tsx
ts-errors.txt
tsc_output.txt
